    "caption": { "size": 12, "lineHeight": 16, "tracking": 0.24, "weight": "500" },
    "micro": { "size": 11, "lineHeight": 14, "tracking": 0.44, "weight": "650", "uppercase": true },
    "priceL": { "size": 20, "lineHeight": 24, "tracking": -0.2, "weight": "800", "tabular": true },
    "priceM": { "size": 15, "lineHeight": 20, "tracking": 0, "weight": "700", "tabular": true }
  },
  "motion": {
    "springs": {
      "snap": { "mass": 0.6, "damping": 20, "stiffness": 300 },
      "glide": { "mass": 1.0, "damping": 18, "stiffness": 170 },
      "pop": { "mass": 0.8, "damping": 11, "stiffness": 220 }
    },
    "durations": { "instant": 100, "quick": 160, "base": 220, "slow": 300, "deliberate": 420 },
    "easings": {
      "enter": [0.05, 0.7, 0.1, 1],
      "exit": [0.3, 0, 0.8, 0.15],
      "standard": [0.2, 0, 0, 1]
    }
