  "radius": { "s": 6, "m": 10, "l": 16, "pill": 999 },
  "space": [0, 2, 4, 8, 12, 16, 20, 24, 32, 40, 48, 64],
  "type": {
    "displayL": { "size": 28, "lineHeight": 32, "tracking": -0.7, "weight": "700" },
    "titleL": { "size": 22, "lineHeight": 28, "tracking": -0.44, "weight": "650" },
    "titleM": { "size": 18, "lineHeight": 24, "tracking": -0.27, "weight": "640" },
