{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile --filter @hillexpress/admin-web... --config.virtual-store-dir=node_modules/.pnpm",
  "buildCommand": "pnpm --filter @hillexpress/shared build && pnpm --filter @hillexpress/admin-web build",
  "outputDirectory": "apps/admin-web/dist",
  "rewrites": [
    {
      "source": "/v1/:path*",
      "destination": "https://hill-express-api-production.up.railway.app/v1/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://hill-express-api-production.up.railway.app/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
