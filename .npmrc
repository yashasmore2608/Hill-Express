# Keep pnpm's deeply-nested virtual store OUT of OneDrive.
# node_modules in the project becomes a shallow tree of symlinks;
# the real files live in C:\pnpm\hill-express (same drive, so hardlinks work).
virtual-store-dir=C:\pnpm\hill-express
virtual-store-dir-max-length=60

# NOTE: no public-hoist-pattern entries. Public hoisting moves packages to the
# PROJECT root node_modules — which files inside the external store (C:\pnpm)
# cannot see — and removes them from the private fallback layer
# (C:\pnpm\hill-express\node_modules) that they CAN see. Undeclared peer
# requires (e.g. react-native-worklets/plugin → @babel/generator) resolve
# through that private layer, so leave hoisting at pnpm defaults.

# Fallback if Metro ever misbehaves with the isolated linker:
# uncomment the next line and delete node_modules + reinstall.
# node-linker=hoisted

engine-strict=true
